// Original Mac product, private durable SQLite data and process-memory credentials.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS =
CODE_SIGNING_ALLOWED = NO
ENABLE_HARDENED_RUNTIME = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PENDINGCREW_KNOWLEDGE_VALIDATION
PENDINGCREW_VALIDATION_SOURCE_REF =
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -Wl,-dead_strip_dylibs
