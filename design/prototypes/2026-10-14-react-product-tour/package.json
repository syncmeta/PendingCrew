{
  "name": "@pendingname/pendingcrew-product-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-portable.mjs && vite build --config vite.library.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "test:domain": "node --import tsx --test src/domain/*.test.ts",
    "test:browser": "node scripts/browser-tests.mjs",
    "test": "npm run test:domain && npm run test:browser",
    "verify": "npm run build && npm test",
    "format": "prettier --write src examples scripts *.json *.ts index.html"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/pendingcrew-tour.js"
    },
    "./styles.css": "./lib/pendingcrew-tour.css"
  },
  "files": [
    "lib",
    "README.md"
  ]
}
