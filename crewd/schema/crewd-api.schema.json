{
  "$defs": {
    "Ask": {
      "description": "一条人类待确认（H 号按机组发，§19 Q1）。",
      "properties": {
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "ask": {
          "description": "\"H3\"",
          "type": "string"
        },
        "askedAt": {
          "type": "string"
        },
        "askedBy": {
          "description": "提问的 session；None = 系统 / 人。",
          "type": [
            "string",
            "null"
          ]
        },
        "closedAt": {
          "description": "回答 / 按默认办 / 撤回的时间。",
          "type": [
            "string",
            "null"
          ]
        },
        "crewId": {
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskDefault"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "description": "关于哪个工作项（\"W2\"）。",
          "type": [
            "string",
            "null"
          ]
        },
        "messageId": {
          "description": "人类群里那条公告。",
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string"
        },
        "resumeNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/AskStateView"
        },
        "withdrawReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "crewId",
        "ask",
        "question",
        "askedAt",
        "state"
      ],
      "type": "object"
    },
    "AskAnswerParams": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "type": "string"
        },
        "crewId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "crewId",
        "ask",
        "text"
      ],
      "type": "object"
    },
    "AskDefault": {
      "properties": {
        "afterMinutes": {
          "format": "int64",
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "afterMinutes"
      ],
      "type": "object"
    },
    "AskListParams": {
      "additionalProperties": false,
      "description": "全可选：`null` 当 `{}`。",
      "properties": {
        "homeCrewId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "AskStateView": {
      "enum": [
        "open",
        "answered",
        "defaulted",
        "withdrawn"
      ],
      "type": "string"
    },
    "AskWithdrawParams": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "type": "string"
        },
        "crewId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "crewId",
        "ask",
        "reason"
      ],
      "type": "object"
    },
    "Attachment": {
      "description": "模型类型对库里读出来的行宽松（多余的键忽略）；客户端参数用严格的 `AttachmentParam`。",
      "properties": {
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "mime",
        "path"
      ],
      "type": "object"
    },
    "AttachmentParam": {
      "additionalProperties": false,
      "description": "客户端给的附件（`message.post`；非空一律拒，裁定 14）。线上形状同 `Attachment`。",
      "properties": {
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "mime",
        "path"
      ],
      "type": "object"
    },
    "Badge": {
      "properties": {
        "channelId": {
          "type": "string"
        },
        "humanMentions": {
          "format": "int64",
          "type": "integer"
        },
        "unreadForHuman": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "channelId",
        "unreadForHuman",
        "humanMentions"
      ],
      "type": "object"
    },
    "Channel": {
      "properties": {
        "archivedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "description": "\"human\" | \"system\" | session id。",
          "type": "string"
        },
        "crewId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChannelKind"
        },
        "name": {
          "description": "大厅 / 人类群是空串（客户端按 kind 显示）。",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "群主（§22.7 Q2）。大厅 / 人类群 = 归属机组此刻的机长（现算；没有机长时 None）。topic / dm 存的是群主；\n删机组时群主随之消失、群里又一个成员不剩，就没有群主（None），只能由机长 / 人 `force_owner`。"
        },
        "pendingOwner": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "待接受的群主转让对象。"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "crewId",
        "kind",
        "name",
        "createdBy",
        "createdAt"
      ],
      "type": "object"
    },
    "ChannelCreateParams": {
      "additionalProperties": false,
      "properties": {
        "crewId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChannelKind",
          "description": "只能是 topic 或 dm。"
        },
        "members": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MemberParam"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "purpose": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "crewId",
        "kind"
      ],
      "type": "object"
    },
    "ChannelKind": {
      "enum": [
        "lobby",
        "human",
        "topic",
        "dm"
      ],
      "type": "string"
    },
    "ChannelMemberParams": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/MemberParam"
        }
      },
      "required": [
        "channelId",
        "member"
      ],
      "type": "object"
    },
    "ChannelMembersParams": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/MemberParam"
          },
          "type": "array"
        }
      },
      "required": [
        "channelId",
        "members"
      ],
      "type": "object"
    },
    "ChannelRef": {
      "description": "`channel.removed` 的数据：群随机组删除被级联删掉了（删了的群读不到，发不出 `channel.changed`）。",
      "properties": {
        "channelId": {
          "type": "string"
        }
      },
      "required": [
        "channelId"
      ],
      "type": "object"
    },
    "ChannelSetOwnerParams": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/MemberParam"
        }
      },
      "required": [
        "channelId",
        "owner"
      ],
      "type": "object"
    },
    "ChannelSummary": {
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "humanMentions": {
          "description": "未读里 @人类 的条数（红色「叫你」标记，§17）。",
          "format": "int64",
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/MemberRef"
          },
          "type": "array"
        },
        "unreadForHuman": {
          "format": "int64",
          "type": "integer"
        },
        "watched": {
          "description": "人类标了「我在注视」。",
          "type": "boolean"
        }
      },
      "required": [
        "channel",
        "members",
        "watched",
        "unreadForHuman",
        "humanMentions"
      ],
      "type": "object"
    },
    "ChannelUpdateParams": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "channelId": {
          "type": "string"
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channelId"
      ],
      "type": "object"
    },
    "ChannelWatchParams": {
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "channelId",
        "on"
      ],
      "type": "object"
    },
    "Crew": {
      "properties": {
        "archivedAt": {
          "description": "归档时刻（删机组 = 归档，N1 裁定 13）；没归档时不出现。",
          "type": [
            "string",
            "null"
          ]
        },
        "captainExecutor": {
          "description": "机长的执行器类型，词表同 `Session.executor`。",
          "type": [
            "string",
            "null"
          ]
        },
        "captainSessionId": {
          "description": "此刻的机长（裁定 8）。",
          "type": [
            "string",
            "null"
          ]
        },
        "childIds": {
          "default": [],
          "description": "这个机组的直系子机组，按侧栏顺序（每个父下各自一套次序，控制者裁定 C1；`crew.reorder {parentId}` 改它）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "createdAt": {
          "type": "string"
        },
        "hiddenAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "number": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "orgRoot": {
          "description": "组织唯一的根（总机组，spec §24 H2）；至多一个。",
          "type": "boolean"
        },
        "parentIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy": {
          "description": "委派策略（M3b 的 read / update_delegation_policy），自由 JSON。"
        },
        "position": {
          "default": 0,
          "description": "只有总机组用（恒为 1）；子机组的次序看父的 `childIds`（多父机组在每个父下各有自己的次序）。",
          "format": "int64",
          "type": "integer"
        },
        "statusLine": {
          "description": "机长写的一句状态（`set_crew_status`）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "titleSource": {
          "description": "\"human\" | \"captain\" | \"auto\"（谁起的名；旧数据从 extra 回填）。",
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "string"
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "orgRoot",
        "parentIds",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "CrewAdoptParams": {
      "additionalProperties": false,
      "properties": {
        "crewId": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        }
      },
      "required": [
        "crewId",
        "parentId"
      ],
      "type": "object"
    },
    "CrewCreateParams": {
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "workingDirectory"
      ],
      "type": "object"
    },
    "CrewDetail": {
      "properties": {
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelSummary"
          },
          "type": "array"
        },
        "children": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "crew": {
          "$ref": "#/$defs/Crew"
        },
        "homeId": {
          "description": "这个机组的人类群在 `<homeId>/human`；总机组 / 一级机组 = 自己（多父归最早建的一级祖先，§13 Q1 同口径）。",
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "type": "array"
        }
      },
      "required": [
        "crew",
        "homeId",
        "children",
        "channels",
        "sessions"
      ],
      "type": "object"
    },
    "CrewIdParams": {
      "additionalProperties": false,
      "properties": {
        "crewId": {
          "type": "string"
        }
      },
      "required": [
        "crewId"
      ],
      "type": "object"
    },
    "CrewListParams": {
      "additionalProperties": false,
      "description": "全可选：`null` 当 `{}`。归档的机组默认不列；`includeArchived: true` 连它们一起列。\n`Crew.childIds` 照实含归档的子机组（边还在）：列表里没有的 id 跳过即可。",
      "properties": {
        "includeArchived": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "CrewRef": {
      "description": "`crew.removed` 的数据。",
      "properties": {
        "crewId": {
          "type": "string"
        }
      },
      "required": [
        "crewId"
      ],
      "type": "object"
    },
    "CrewReleaseParams": {
      "additionalProperties": false,
      "properties": {
        "crewId": {
          "type": "string"
        },
        "fromParentId": {
          "type": "string"
        },
        "toParentId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "crewId",
        "fromParentId"
      ],
      "type": "object"
    },
    "CrewReorderParams": {
      "additionalProperties": false,
      "description": "侧栏次序按父边分层（控制者裁定 C1）：一次只排**一层**。\n排 `parentId` 名下的直系子机组（写的是这条父边上的次序，读回来是父的 `Crew.childIds`；\n多父机组在别的父下的次序不受影响）。顶层只剩总机组：一级机组的次序 = `parentId` 给总机组。\n`crewIds` 必须恰好是这一层现有的全部机组（不重复、不缺、不多），否则 -32602。",
      "properties": {
        "crewIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parentId": {
          "type": "string"
        }
      },
      "required": [
        "parentId",
        "crewIds"
      ],
      "type": "object"
    },
    "CrewUpdateParams": {
      "additionalProperties": false,
      "properties": {
        "crewId": {
          "type": "string"
        },
        "hidden": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "statusLine": {
          "default": null,
          "description": "\"\" = 清掉。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workingDirectory": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "crewId"
      ],
      "type": "object"
    },
    "DecisionView": {
      "properties": {
        "numbered": {
          "description": "选项带编号（按编号答）；false = 光标式菜单（绝不编造编号，§15）。",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "options",
        "numbered"
      ],
      "type": "object"
    },
    "Desired": {
      "enum": [
        "running",
        "stopped"
      ],
      "type": "string"
    },
    "DirectoryKind": {
      "enum": [
        "crew",
        "session"
      ],
      "type": "string"
    },
    "DirectoryListParams": {
      "additionalProperties": false,
      "description": "全可选：`null` 当 `{}`。",
      "properties": {
        "query": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "DirectoryRow": {
      "properties": {
        "crewId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DirectoryKind"
        },
        "name": {
          "type": "string"
        },
        "number": {
          "description": "\"7\" 或 \"7-3\"",
          "type": "string"
        },
        "orgPath": {
          "description": "上级的路径：一级机组在最左，\" / \" 分隔；总机组是所有人的祖先、不进路径（总机组与一级机组本身是空串）。",
          "type": "string"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "number",
        "kind",
        "name",
        "crewId",
        "orgPath"
      ],
      "type": "object"
    },
    "Empty": {
      "additionalProperties": false,
      "description": "空结果（`crew.purge` 等）。",
      "type": "object"
    },
    "Event": {
      "description": "服务端推的事件；按 `event` 区分，`data` 的类型随之确定。",
      "oneOf": [
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Message"
            },
            "event": {
              "const": "message.appended",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/ChannelSummary"
            },
            "event": {
              "const": "channel.changed",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/ChannelRef"
            },
            "event": {
              "const": "channel.removed",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Crew"
            },
            "event": {
              "const": "crew.changed",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/CrewRef"
            },
            "event": {
              "const": "crew.removed",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Badge"
            },
            "event": {
              "const": "badge.changed",
              "type": "string"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Ask"
            },
            "event": {
