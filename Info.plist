<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PendingCrew</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pendingname.pendingcrew</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pendingcrew</string>
			</array>
		</dict>
		<!-- Google Sign-In reversed-client-ID URL scheme (placeholder until
		     the real iOS OAuth client ID is created in Google Cloud Console
		     and filled in here + in GIDClientID below). GoogleSignIn will
		     throw a clear error on the "YOUR_" prefix at runtime — Apple/
		     email paths are unaffected. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.googleusercontent.apps.YOUR_PENDINGCREW_IOS_CLIENT_ID</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.YOUR_PENDINGCREW_IOS_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<!-- Google Sign-In client ID (placeholder — replace with the real iOS
	     client ID from Google Cloud Console once the PendingCrew OAuth app
	     is created). GoogleSignIn checks this at sign-in time and will throw
	     "GIDSignIn requires GIDClientID" on the "YOUR_" prefix, giving a
	     clear error without silently misconfiguring the auth flow. -->
	<key>GIDClientID</key>
	<string>YOUR_PENDINGCREW_IOS_CLIENT_ID.apps.googleusercontent.com</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://updates.pendingname.com/pendingcrew/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>3f98RPhTgkOdhv2emkE232Q/NgBnZd8VsFUnjE+hp78=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!-- iPhone 方向（无后缀这份是 iPhone 用的）。不含
	     PortraitUpsideDown —— 对齐 apps/pendingbot，也是 iPhone 惯例。
	     缺这份键 App Store 提交会被 ASC 校验挡。 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
